# Writes OUT, a C++ file holding every .po of FILES ("|"-separated) as a byte
# array, with the table frontend/i18n/i18n.cpp reads (detail::kBuiltinPo).
# Run at build time by src/frontend/i18n/CMakeLists.txt.
string(REPLACE "|" ";" files "${FILES}")
set(src "// Generated by cmake/embed_po.cmake from po/*.po; do not edit.\nnamespace ds::i18n::detail {\nstruct BuiltinPo { const char* code; const char* begin; const char* end; };\n")
set(table "")
set(n 0)
foreach(f IN LISTS files)
  if(f STREQUAL "")
    continue()
  endif()
  get_filename_component(code "${f}" NAME_WE)
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" len)
  math(EXPR bytes "${len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
  string(APPEND src "static const unsigned char kPo${n}[] = {${body}0};\n")
  string(APPEND table "  {\"${code}\", reinterpret_cast<const char*>(kPo${n}), reinterpret_cast<const char*>(kPo${n}) + ${bytes}},\n")
  math(EXPR n "${n} + 1")
endforeach()
string(APPEND src "extern const BuiltinPo kBuiltinPo[] = {\n${table}  {nullptr, nullptr, nullptr},\n};\nextern const unsigned kBuiltinPoCount = ${n};\n}  // namespace ds::i18n::detail\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL src)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${src}")
